      "name": "daily_body_metrics",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_body_metrics\" (\"day\" TEXT NOT NULL, \"measured_at\" INTEGER NOT NULL, \"weight_kg\" REAL NOT NULL, \"body_fat_percent\" REAL NULL, \"lean_mass_kg\" REAL NULL, \"lean_mass_estimated\" INTEGER NOT NULL DEFAULT 0 CHECK (\"lean_mass_estimated\" IN (0, 1)), \"synced_at\" INTEGER NOT NULL, PRIMARY KEY (\"day\"));"
        }
      ]
    },
    {
      "name": "food_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"food_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"eaten_at\" INTEGER NOT NULL, \"meal\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"servings\" REAL NOT NULL DEFAULT 1.0, \"kcal\" REAL NULL, \"protein_g\" REAL NULL, \"carbs_g\" REAL NULL, \"fat_g\" REAL NULL, \"note\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
