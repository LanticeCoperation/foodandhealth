  "fixed_sql": [
    {
      "name": "daily_body_metrics",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_body_metrics\" (\"day\" TEXT NOT NULL, \"measured_at\" INTEGER NOT NULL, \"weight_kg\" REAL NOT NULL, \"body_fat_percent\" REAL NULL, \"lean_mass_kg\" REAL NULL, \"lean_mass_estimated\" INTEGER NOT NULL DEFAULT 0 CHECK (\"lean_mass_estimated\" IN (0, 1)), \"synced_at\" INTEGER NOT NULL, PRIMARY KEY (\"day\"));"
        }
      ]
    },
    {
      "name": "food_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"food_entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"eaten_at\" INTEGER NOT NULL, \"meal\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"servings\" REAL NOT NULL DEFAULT 1.0, \"kcal\" REAL NULL, \"protein_g\" REAL NULL, \"carbs_g\" REAL NULL, \"fat_g\" REAL NULL, \"note\" TEXT NULL, \"template_id\" INTEGER NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "meal_templates",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"meal_templates\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"meal\" TEXT NULL, \"default_servings\" REAL NOT NULL DEFAULT 1.0, \"kcal\" REAL NULL, \"protein_g\" REAL NULL, \"carbs_g\" REAL NULL, \"fat_g\" REAL NULL, \"pinned\" INTEGER NOT NULL DEFAULT 0 CHECK (\"pinned\" IN (0, 1)), \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"use_count\" INTEGER NOT NULL DEFAULT 0, \"last_used_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "daily_checks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"daily_checks\" (\"day\" TEXT NOT NULL, \"item\" TEXT NOT NULL, \"checked_at\" INTEGER NOT NULL, PRIMARY KEY (\"day\", \"item\"));"
        }
      ]
    },
    {
      "name": "phases",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"phases\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"start_day\" TEXT NOT NULL, \"end_day\" TEXT NOT NULL, \"hypothesis\" TEXT NULL, \"target_kcal\" REAL NULL, \"target_protein_g\" REAL NULL, \"creatine\" INTEGER NOT NULL DEFAULT 0 CHECK (\"creatine\" IN (0, 1)), \"conclusion\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" INTEGER NOT NULL, \"sex\" TEXT NOT NULL, \"birth_year\" INTEGER NOT NULL, \"height_cm\" REAL NOT NULL, \"activity\" TEXT NOT NULL, \"weight_kg\" REAL NOT NULL, \"tdee_kcal\" REAL NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
